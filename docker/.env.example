# ScaleForge Docker environment example.
# Copy this file to .env and change values before deployment.

# Optional mirror prefix for users who cannot access Docker Hub.
# Example: REGISTRY_MIRROR=docker.1ms.run/
REGISTRY_MIRROR=

# Public Headscale URL used by clients. Keep the port aligned with HS_PORT.
HEADSCALE_SERVER_URL=http://YOUR_SERVER_IP:8080
HS_PORT=8080
WEB_PORT=80

# Image versions.
AE_VERSION=latest
BACKEND_VERSION=latest
NGINX_VERSION=latest

# PostgreSQL.
POSTGRES_DB=headscale_admin
POSTGRES_USER=headscale_admin
POSTGRES_PASSWORD=HsAdmin@2026PG

# Headscale.
HEADSCALE_DNS_DOMAIN=hs.admin.pro
HEADSCALE_LOG_LEVEL=info

# Optional private DERP relay.
DERP_DOMAIN=YOUR_SERVER_IP
DERP_STUN_PORT=3478
DERP_HTTP_PORT=3479

# ScaleForge backend.
SECRET_KEY=headscale-admin-secret-2026

# ScaleTail client reporting token. Must match the token configured in ScaleTail.
SCALETAIL_CLIENT_TOKEN=change-me-scaletail-client-token

# Cap CAPTCHA.
# Docs: https://trycap.dev/guide/
CAPTCHA_ENABLED=true
CAPTCHA_WIDGET_SRC=https://cdn.jsdelivr.net/npm/cap-widget
CAPTCHA_API_ENDPOINT=http://YOUR_CAP_SERVER:30030/YOUR_SITE_KEY/
CAPTCHA_SITEVERIFY_URL=http://YOUR_CAP_SERVER:30030/siteverify
CAPTCHA_SECRET_KEY=change-me-cap-secret

# Optional IP geolocation endpoint. Leave empty to disable enrichment.
# Example: IP_GEOLOOKUP_URL=https://ipwho.is/{ip}
IP_GEOLOOKUP_URL=
