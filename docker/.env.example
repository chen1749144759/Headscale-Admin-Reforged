# Headscale Admin Docker 环境变量
# 复制此文件为 .env 并修改

# ==================== 必须修改 ====================
# Headscale 对外访问地址（改为你的公网IP或域名）
# 注意：这里的端口必须和下方 HS_PORT 保持一致
HEADSCALE_SERVER_URL=http://YOUR_SERVER_IP:8080

# ==================== 镜像加速（国内用户） ====================
# 如果无法访问 Docker Hub，取消下一行注释即可走镜像加速
# REGISTRY_MIRROR=docker.1ms.run/

# ==================== 可选修改 ====================
# PostgreSQL
POSTGRES_DB=headscale_admin
POSTGRES_USER=headscale_admin
POSTGRES_PASSWORD=HsAdmin@2026PG

# Headscale
AE_VERSION=latest
HEADSCALE_DNS_DOMAIN=hs.admin.pro
HEADSCALE_LOG_LEVEL=info

# 内嵌 DERP 中继配置
# DERP_DOMAIN: 客户端连接 DERP 的公网 IP 或域名（留空则使用 server_url 的地址）
# DERP_PORT: DERP/STUN 监听端口（容器内部），HS_STUN_PORT 为宿主机映射端口
DERP_DOMAIN=
DERP_PORT=3478

# 管理面板 JWT 密钥（建议修改为随机字符串）
SECRET_KEY=headscale-admin-secret-2026

# 端口映射（宿主机端口）
# 修改 HS_PORT 后，上方 HEADSCALE_SERVER_URL 的端口也要同步修改
HS_PORT=8080
HS_STUN_PORT=3478
WEB_PORT=80
