# Image versions
REGISTRY_MIRROR=
AE_VERSION=latest
BACKEND_VERSION=latest
NGINX_VERSION=latest

# Public endpoints. Account authentication requires a trusted HTTPS control URL.
HEADSCALE_SERVER_URL=https://headscale.example.com
HS_BIND_IP=127.0.0.1
HS_PORT=8080
HEADSCALE_TRUST_PROXY=true
# Comma-separated CIDRs of reverse proxies allowed to supply client IP headers.
# Narrow this to the actual Docker/reverse-proxy network in production.
HEADSCALE_TRUSTED_PROXY_CIDRS=172.16.0.0/12
DERP_BIND_IP=0.0.0.0
DERP_STUN_PORT=3478
DERP_DOMAIN=derp.example.com

# The management UI binds to loopback by default. Put an HTTPS reverse proxy in
# front of it, or deliberately change WEB_BIND_IP after applying a firewall.
WEB_BIND_IP=127.0.0.1
WEB_PORT=80
TRUSTED_ORIGINS=https://admin.example.com
# Scheme seen by browsers at the trusted outer reverse proxy. For isolated
# direct HTTP development, set this to http and SESSION_COOKIE_SECURE=false.
SCALEFORGE_EXTERNAL_SCHEME=https

# Database administrator credentials are used only by bootstrap/migrations.
POSTGRES_DB=headscale_admin
POSTGRES_USER=headscale_admin
POSTGRES_PASSWORD=replace-with-a-long-random-admin-password

# Runtime roles are independent and must use different random passwords.
HEADSCALE_DB_USER=headscale_runtime
HEADSCALE_DB_PASSWORD=replace-with-a-long-random-headscale-password
SCALEFORGE_DB_USER=scaleforge_runtime
SCALEFORGE_DB_PASSWORD=replace-with-a-long-random-scaleforge-password
SCALEFORGE_DB_OWNER=scaleforge_owner
# PostgreSQL lock/statement timeouts used only by the migration job.
SCALEFORGE_MIGRATION_LOCK_TIMEOUT_MS=15000
SCALEFORGE_MIGRATION_STATEMENT_TIMEOUT_MS=300000

# The first manager password is read from docker/secrets/scaleforge_bootstrap_password.
SCALEFORGE_BOOTSTRAP_USERNAME=admin
SCALEFORGE_MAX_NODES_PER_ACCOUNT=20

# Keep true behind HTTPS. Set false only for isolated loopback development.
SESSION_COOKIE_SECURE=true
ENABLE_API_DOCS=false

# Set to 1 for the first upgrade from a config without the scaleforge section,
# then restore 0 after one successful controlled restart.
HEADSCALE_FORCE_RENDER_CONFIG=0
HEADSCALE_LOG_LEVEL=info

# Initial DNS defaults. Later changes are persisted by Headscale and hot-applied
# from ScaleForge; the base domain remains a restart-time setting.
HEADSCALE_DNS_DOMAIN=hs.admin.pro
HEADSCALE_MAGIC_DNS=true
HEADSCALE_DNS_OVERRIDE_LOCAL=true
HEADSCALE_DNS_GLOBAL=1.1.1.1,8.8.8.8
HEADSCALE_DNS_SEARCH_DOMAINS=

# Optional CAPTCHA configuration. The browser widget is bundled in the image;
# only the challenge endpoint and server-side verification credentials are remote.
CAPTCHA_ENABLED=true
CAPTCHA_API_ENDPOINT=https://captcha.example.com/site-key/
CAPTCHA_SITEVERIFY_URL=https://captcha.example.com/site-key/siteverify
CAPTCHA_SECRET_KEY=replace-with-captcha-secret

# Optional server-side geolocation endpoint. Leave empty to disable enrichment.
IP_GEOLOOKUP_URL=
