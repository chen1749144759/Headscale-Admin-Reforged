# 自定义 DERP Map 模板
# entrypoint.sh 会通过 envsubst 渲染此文件为 /etc/headscale/derp.yaml
#
# 变量说明（在 .env 中配置）:
#   DERP_DOMAIN  - DERP 服务器公网 IP 或域名
#   DERP_STUN_PORT - STUN 端口（UDP），需与路由器 NAT 映射一致
#   DERP_HTTP_PORT - DERP relay 端口（TCP），需与路由器 NAT 映射一致

regions:
  999:
    regionid: 999
    regioncode: myderp
    regionname: My Private DERP
    nodes:
      - name: "999a"
        regionid: 999
        hostname: ${DERP_DOMAIN}
        stunport: ${DERP_STUN_PORT}
        derpport: ${DERP_HTTP_PORT}
        insecurefortests: true
